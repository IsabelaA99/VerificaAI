# Apura Web — variáveis de ambiente (Vite lê só as que começam com VITE_).
# ATENÇÃO (RNF16): tudo que começa com VITE_ vai para o pacote enviado ao navegador.
# Nunca coloque chaves, tokens ou segredos aqui.

# Endereço base da API v1. Padrão: mesma origem, em /api (ADR-006: o nginx serve a
# interface em / e repassa /api/ ao Django, o que mantém o cookie de sessão
# SameSite=Lax funcionando). Só mude se a API estiver em outra origem — nesse caso
# o back end precisa liberar o cabeçalho X-Visitor-Id no CORS.
VITE_API_BASE_URL=/api

# Destino do proxy de desenvolvimento (npm run dev) para /api. Não vai para o pacote.
DEV_API_PROXY_TARGET=http://localhost:8000

# Prazo máximo de espera por uma análise, em milissegundos (RNF01: 30 s).
VITE_REQUEST_TIMEOUT_MS=30000

# Entrada por link (RF01, RF03, RF24: a pessoa escolhe entre texto e URL).
#   true  = a aba "Inserir link" envia a URL para a API v1.
#   false = a aba aparece como "Em breve" e não pode ser escolhida.
VITE_FEATURE_URL_INPUT=true

# Contas (RF31, RF32, RF34) e feedback (RF19): o back end ainda não tem esses
# endpoints (Etapa 4).
#   demo = fluxo demonstrativo no navegador, com aviso visível, sem enviar nada
#   off  = recurso oculto
VITE_ACCOUNTS_MODE=demo
VITE_FEEDBACK_MODE=demo

# A API v1 já analisa links e consulta fontes. Estas chaves só mudam os textos de
# "Como funciona" e "Privacidade"; use false apenas com um back end anterior.
VITE_BACKEND_URL_ANALYSIS=true
VITE_BACKEND_SOURCES=true

# Botão do chatbot do WhatsApp (canto da tela). Número com código do país, só dígitos.
# No sandbox da Twilio, cada pessoa precisa enviar o código "join …" uma vez antes de usar:
# o botão abre uma janela que explica isso e um link com o código já escrito.
# Com um número oficial do WhatsApp, deixe VITE_WHATSAPP_JOIN_CODE vazio: o botão abre direto a conversa.
VITE_WHATSAPP_NUMBER=14155238886
VITE_WHATSAPP_JOIN_CODE=join division-facing
