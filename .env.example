# Copie para .env e ajuste os valores. Nunca versione o .env.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DJANGO_SECURE_COOKIES=false

# Banco (padrão: SQLite local). Para PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=apura_db
# DB_USER=apura_user
# DB_PASSWORD=apura_password
# DB_HOST=localhost
# DB_PORT=5432

# Modelo (MODEL_PATH relativo à raiz do repositório ou absoluto)
MODEL_PATH=bert_fakenews_v4
MODEL_HUB_ID=oficialmarlon/bertimbau-fakenews-detector-v4
MODEL_VERSION=bertimbau-fakenews-v4
MODEL_DEVICE=auto
MODEL_MAX_LEN=128
CHUNK_STRIDE=16
MODEL_WARMUP=true

# API
API_ANON_RATE=30/min
LOG_LEVEL=INFO

# Integrações externas opcionais (possuem fallback inteligente se vazias)
# GOOGLE_FACT_CHECK_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
