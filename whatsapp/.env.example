# Copie para .env (que NUNCA vai para o repositório) e preencha.
# O chatbot lê estas variáveis ao iniciar e recusa iniciar se algo essencial estiver errado.

# --- API do Apura ---------------------------------------------------------------------------
# Endereço da API, sem a versão no final (o chatbot usa /v1/analyses/).
# Em Docker Compose, use o nome do serviço. O nome que você usar aqui precisa estar em
# DJANGO_ALLOWED_HOSTS do back end (ex.: web ou nginx), senão o Django responde 400.
APURA_API_BASE_URL=http://localhost:8000/api
# Tempo máximo para conectar e para a API responder (RNF01: 30 s).
APURA_API_CONNECT_TIMEOUT_SECONDS=5
APURA_API_TIMEOUT_SECONDS=30

# --- Twilio ---------------------------------------------------------------------------------
# Console da Twilio > Account Info. O Auth Token é segredo: nunca no código, nunca em log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Mantenha true. Só use false em desenvolvimento local, para testar sem a Twilio.
TWILIO_VALIDATE_SIGNATURE=true
# URL exata cadastrada na Twilio para o webhook (inclua https:// e /mensagem). Recomendado
# quando houver proxy ou túnel (ngrok) na frente do chatbot, porque a assinatura depende dela.
PUBLIC_WEBHOOK_URL=

# --- Comportamento --------------------------------------------------------------------------
# A Twilio desiste do webhook em 15 s. Se a análise passar deste tempo (entre 1 e 14 s), o chatbot
# avisa que está analisando e envia o resultado depois (precisa de TWILIO_ACCOUNT_SID).
SYNC_WAIT_SECONDS=12
# Análises simultâneas por processo.
MAX_WORKERS=8
# Entrada por link: a API abre a página e extrai a notícia. Use false para recusar links.
URL_INPUT_ENABLED=true
# Endereço público da interface web, sem barra no final. Quando preenchido, a resposta termina
# com o link da página completa do resultado.
WEB_BASE_URL=

# Porta do servidor de desenvolvimento (python app.py).
PORT=5000
